# ===== Proxmox Dashboard — konfigurasi =====
# Salin ke .env lalu isi. Jangan commit .env asli.

# --- Server dashboard ---
PORT=3000
BIND_ADDRESS=0.0.0.0

# --- Koneksi Proxmox VE ---
PVE_HOST=192.168.1.10
PVE_PORT=8006
PVE_NODE=pve
# API Token (buat via: pveum user token add automation@pve automate --privsep 0)
PVE_TOKEN_ID=automation@pve!automate
PVE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Self-signed cert default = false. Set true bila pakai cert valid.
PVE_VERIFY_SSL=false

# --- Keamanan dashboard ---
# Kosong = dashboard TERBUKA (hanya untuk LAN terisolasi).
# Isi string acak panjang untuk mengaktifkan proteksi token.
DASHBOARD_TOKEN=

# --- Default nilai form create ---
DEFAULT_STORAGE=local-lvm
DEFAULT_BRIDGE=vmbr0
DEFAULT_CT_TEMPLATE_STORAGE=local
# Contoh: local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst
DEFAULT_CT_TEMPLATE=

# --- Realtime ---
POLL_INTERVAL=5000
