# ===== Proxmox Dashboard — konfigurasi =====
# Salin ke .env lalu isi. Jangan commit .env asli.

# --- Server dashboard ---
PORT=3000
BIND_ADDRESS=0.0.0.0

# --- Koneksi Proxmox VE ---
PVE_HOST=192.168.1.10
PVE_PORT=8006
PVE_NODE=pve
# API Token (buat via: pveum user token add automation@pve automate --privsep 0)
PVE_TOKEN_ID=automation@pve!automate
PVE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Self-signed cert default = false. Set true bila pakai cert valid.
PVE_VERIFY_SSL=false

# --- Keamanan dashboard ---
# LOGIN (disarankan): set username + password → dashboard butuh login.
# Password di-hash scrypt saat boot (tak disimpan plaintext di memori sesudahnya).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=ganti-dengan-password-kuat
# Alternatif lebih aman: simpan HASH scrypt (bukan plaintext). Buat dengan:
#   node -e "import('./src/auth.js').then(m=>console.log(m.hashPassword(process.argv[1])))" 'PasswordAnda'
# Bila DASHBOARD_PASSWORD_HASH diisi, DASHBOARD_PASSWORD diabaikan.
DASHBOARD_PASSWORD_HASH=
# Rahasia tanda-tangan sesi. Kosongkan → auto-generate & simpan ke .session-secret (mode 600).
# Isi manual (string acak >=32 char) bila ingin sesi tetap valid lintas server/restart.
SESSION_SECRET=
# Token header legacy (opsional, untuk akses API programatik/skrip). Kosong = nonaktif.
DASHBOARD_TOKEN=

# --- Default nilai form create ---
DEFAULT_STORAGE=local-lvm
DEFAULT_BRIDGE=vmbr0
DEFAULT_CT_TEMPLATE_STORAGE=local
# Contoh: local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst
DEFAULT_CT_TEMPLATE=

# --- Realtime ---
POLL_INTERVAL=5000
